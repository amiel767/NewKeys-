<?xml version="1.0" encoding="utf-8"?>
<!--
  Profondeur d'une carte de bibliotheque Sheets, en vector drawable (XML) :
  liseret clair en haut, liseret sombre en bas, bande de lumiere diagonale.
  Dessine PAR-DESSUS le remplissage uni a la teinte de la feuille ; l'ombre
  portee vient du modifier `shadow`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- bande de lumiere diagonale : le volume -->
    <path android:pathData="M0,0 L100,0 L100,100 L0,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="100" android:endY="100">
                <item android:offset="0" android:color="#24FFFFFF" />
                <item android:offset="0.45" android:color="#0AFFFFFF" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- liseret haut : la lumiere qui accroche l'arete -->
    <path android:pathData="M0,0 L100,0 L100,1.6 L0,1.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="1.6">
                <item android:offset="0" android:color="#59FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- liseret bas : l'ombre qui pose la carte -->
    <path android:pathData="M0,98 L100,98 L100,100 L0,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="98"
                android:endX="0" android:endY="100">
                <item android:offset="0" android:color="#00000000" />
                <item android:offset="1" android:color="#3D000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
